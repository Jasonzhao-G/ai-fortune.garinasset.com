# App 所有者配置（部署时在 Vercel / 服务器环境变量中设置，用户不可见）

# DeepSeek API（推荐）
DEEPSEEK_API_KEY=sk-your-key-here

# 或使用 OpenAI
# OPENAI_API_KEY=sk-your-key-here

# 可选：指定服务商 deepseek | openai | custom
# LLM_PROVIDER=deepseek

# 可选：自定义 API 地址和模型
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 可选：强制使用本地 mock（联调 UI 时可开启）
# FORCE_MOCK_MODE=false

# 未配置 API Key 时，自动使用本地模拟分析

# 灵宠商城 · 微店（实物/NFC 跳转，可公开）
# NEXT_PUBLIC_WEIDIAN_STORE_URL=https://weidian.com/?userid=你的微店ID

# 灵宠商城 · 聚合支付（虚拟商品，仅服务端）
# PAY_AGGREGATOR_MERCHANT_ID=
# PAY_AGGREGATOR_SECRET=
# PAY_ORDER_SECRET=

# 运营后台 + 用户/订单统计（推荐 Neon Postgres 连接串）
# DATABASE_URL=postgresql://...

# 管理员登录（Production 必填；勿提交到 Git）
# ADMIN_PASSWORD=your-strong-password
# ADMIN_SESSION_SECRET=random-long-string
